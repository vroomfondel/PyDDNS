-@register.filter(name='last_update')
-def last_update(subdomain):
+@register.filter(name='last_seen')
+def last_seen(subdomain):
+    """When the client for this subdomain last successfully reached us.
+
+    Counts `nochg` as well as `good`. Was `last_update`, which looked at
+    `good` alone -- but a router whose address does not change reports
+    `nochg` every few minutes and nothing else, so the column drifted further
+    from reality the longer everything worked. Measured on a live install: a
+    box that had reported 26 minutes earlier was shown as "1 hour 20".
+
+    Deliberately NOT the other codes. `badauth`, `nohost` and `abuse` mean the
+    client reached us and was rejected; counting them would make a
+    misconfigured router look healthy, which is the one thing this column
+    exists to reveal.
+
+    Renamed because it no longer answers "when did this record last change".
+    Since the address beside it is resolved from DNS (see current_ip), that
+    question has no reliable answer here anyway -- a record changed by any
+    other route leaves no log row at all.
+    """
     domain = '%s.%s' % (subdomain, settings.DNS_DOMAIN)
     try:
-        last_activity = Activity_log.objects.filter(action="SYNC", code="good", domain=domain).latest('date')
+        last_activity = Activity_log.objects.filter(
+            action="SYNC", code__in=("good", "nochg"), domain=domain).latest('date')
         return last_activity.date
     except Activity_log.DoesNotExist:
         return "---"
