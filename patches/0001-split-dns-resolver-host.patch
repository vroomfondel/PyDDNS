+    # original string comparison when either side is unparseable.
+    if ip_dig is not None and addr is not None:
+        changed = ipaddress.ip_address(str(ip_dig)) != addr
+    else:
+        changed = str(ip_dig) != str(ip)
+
+    if changed:
         subdomain = domain.split(".")[0]
         r = requests.get(
