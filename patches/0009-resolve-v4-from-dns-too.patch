+@register.filter(name='current_ip')
+def current_ip(subdomain):
+    """The A record that is live in DNS right now.
+
+    Was `last_ip`, which returned the address of the newest successful SYNC in
+    Activity_log. That is what the client last REPORTED, not what is published:
+    the two drift apart whenever a record is changed by any other route, and
+    the column claims to show where the subdomain points. Renamed rather than
+    quietly redefined, so nothing keeps reading it as "last reported".
+
+    Keeps the "---" placeholder of the old filter for the empty case; the
+    templates render it unconditionally.
+    """
+    return _resolve(subdomain, "A") or "---"
 
 
