+def delete_record(domain, rdtype):
+    """Remove one RRtype for a hostname via the nsupdate backend.
+
+    Counterpart to set_ip for the case where a host no longer has an address
+    of that family. Uses the backend's /delete endpoint, which reports a name
+    carrying no such record as success -- the caller wanted it gone.
+
+    Returns a dyndns2 (code, message) pair so the caller can fold it into the
+    same result handling as an update.
+    """
+    subdomain = domain.split(".")[0]
+    try:
+        r = requests.get(
+            'http://%s:%s/delete' % (settings.DNS_HOST, settings.DNS_API_PORT),
+            params={
+                'secret': settings.DNS_SHARED_SECRET,
+                'domain': subdomain,
+                'rrtype': rdtype,
+            },
+            timeout=10,
+        )
+        if r.json()['Success']:
+            return "good", "The %s record was removed" % rdtype
+    except Exception:
+        pass
+    return "dnserr", "The APP could not remove the %s record" % rdtype
+
