@@ -435,6 +436,28 @@ def set_ip_web(request, domain, ip):
 
 
 
+def split_families(*addresses):
+    """Sort addresses into (v4, v6) for the activity log.
+
+    Not as trivial as "myip is v4, myipv6 is v6": with myip=auto a v6-only
+    client ends up with its address in `ip` and nothing in `ipv6`, and the
+    log columns would then disagree with their own headings. Sorting by what
+    the address actually IS keeps them honest whichever parameter carried it.
+
+    Returns:
+        A ``(v4, v6)`` tuple of strings; either may be empty.
+    """
+    v4 = v6 = ""
+    for a in addresses:
+        if not a:
+            continue
+        if ":" in a:
+            v6 = v6 or a
+        else:
+            v4 = v4 or a
+    return v4, v6
+
