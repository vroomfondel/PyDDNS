diff --git a/appdata/pyddns/pyddns/templatetags/app_filters.py b/appdata/pyddns/pyddns/templatetags/app_filters.py
index 1af1f0f..6045988 100644
--- a/appdata/pyddns/pyddns/templatetags/app_filters.py
+++ b/appdata/pyddns/pyddns/templatetags/app_filters.py
@@ -6,6 +6,8 @@ from django.utils.safestring import mark_safe
 from pyddns.models import SubDomain
 from common.models import Activity_log
 from django.conf import settings
+import socket
+import dns.resolver
 
 
 register = template.Library()
@@ -27,6 +29,35 @@ def last_ip(subdomain):
         return "---"
 
 
+@register.filter(name='current_ip6')
+def current_ip6(subdomain):
+    """The AAAA that is live in DNS right now, or "" if there is none.
+
+    Resolved rather than read back out of Activity_log, because the log cannot
+    answer the question. Its newest `good` row carries an empty ip6 both when a
+    v4-only update simply did not mention v6 (the AAAA is still valid) and when
+    an update explicitly cleared it (the AAAA is gone) -- two opposite states,
+    one representation. Falling back to "the newest row that had an ip6" would
+    show an address that was deleted minutes ago.
+
+    Asks the authoritative server directly (DNS_RESOLVER_HOST), same as
+    views.set_ip, so the answer cannot be a stale cache entry. Any failure --
+    no record, server unreachable, timeout -- yields "" and the template simply
+    shows nothing; a dashboard row is not worth an error page.
+    """
+    domain = '%s.%s' % (subdomain, settings.DNS_DOMAIN)
+    try:
+        resolver = dns.resolver.Resolver()
+        resolver.nameservers = [socket.gethostbyname(settings.DNS_RESOLVER_HOST)]
+        # Short, because this runs once per row while the user waits for the
+        # page. The default 5s lifetime would stall the whole dashboard on an
+        # unreachable master.
+        resolver.lifetime = 2.0
+        return str(resolver.resolve(domain, "AAAA")[0])
+    except Exception:
+        return ""
+
+
 @register.filter(name='last_update')
 def last_update(subdomain):
     domain = '%s.%s' % (subdomain, settings.DNS_DOMAIN)
